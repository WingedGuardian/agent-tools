# Agent Tools — Configuration
# Copy to .env and fill in your values.

# ── x402 Payments ────────────────────────────────────────────────
# Your EVM wallet address to receive USDC payments.
# Leave empty to run without payment gating (dev mode).
# Same address works on Base, Ethereum, and all EVM chains.
AGENT_TOOLS_PAY_TO=

# Set to "false" for mainnet (Base). Default: testnet (Base Sepolia).
AGENT_TOOLS_TESTNET=true
